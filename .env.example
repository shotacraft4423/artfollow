# ==== アプリ保護用 ====
# このWebアプリ自体にかけるログインパスワード(公開ドメインで運用するため必須)
APP_PASSWORD=change-me-to-a-strong-password
# セッションCookieの署名・トークン暗号化に使う秘密鍵。openssl rand -hex 32 などで生成してください
APP_SECRET=change-me-to-a-random-64-character-hex-string

# ==== X (Twitter) API ====
# https://developer.x.com/ の Developer Portal で "OAuth 2.0" を有効にしたアプリを作成し、
# Confidential client として Client ID / Client Secret を取得してください。
# Basic以上のAPIプランが必要です(Freeプランではフォロワー一覧取得APIが使えません)。
X_CLIENT_ID=your-x-oauth2-client-id
X_CLIENT_SECRET=your-x-oauth2-client-secret
# Developer PortalのCallback URLに完全一致させること (例: https://ochinpo.click/api/auth/x/callback)
X_REDIRECT_URI=https://ochinpo.click/api/auth/x/callback
# 通常は未設定でOK(X_REDIRECT_URIのオリジンを自動的に使います)。
# Cloudflare TunnelなどHostヘッダーを書き換えるプロキシ配下で、ログイン後に
# localhost:3000 など誤ったURLへリダイレクトされる場合のみ、公開URLを明示してください。
# PUBLIC_APP_URL=https://artfollow.ochinpo.click

# ==== OpenAI API ====
OPENAI_API_KEY=sk-...
# 分類に使うモデル。コスト重視なら gpt-4o-mini (デフォルト) を推奨
OPENAI_MODEL=gpt-4o-mini

# ==== 動作パラメータ (省略可、以下はデフォルト値) ====
# SQLiteデータベースの保存先
DB_PATH=./data/app.db
# 「絵描きアカウント」と判定する confidence の閾値 (0.0〜1.0)
ARTIST_CONFIDENCE_THRESHOLD=0.6
# true の場合、bioに絵描き関連キーワードが1つもないアカウントはOpenAIを呼ばずに対象外にする(コスト削減)
CLASSIFY_ONLY_HEURISTIC_MATCHES=true
# 直近何件のポストを確認するか (最大100)
RECENT_POSTS_TO_CHECK=50
# true にするとリプライも投稿確認の対象から除外する (リポストは常に除外)
EXCLUDE_REPLIES=false
# フォロー実行時、1件ごとの待機時間(ms)。X APIのレート制限対策
FOLLOW_DELAY_MS=1500
# 投稿取得時、1アカウントごとの待機時間(ms)
TWEETS_FETCH_DELAY_MS=300
# 1回のフォロワー取得スキャンで取得するページ数(1ページ最大1000件)
MAX_FOLLOWER_PAGES_PER_SCAN=5
# 1回の分類実行で処理する最大候補数
MAX_CANDIDATES_PER_CLASSIFY_RUN=30
# OpenAIへ1リクエストにまとめて送るアカウント数
OPENAI_BATCH_SIZE=10
